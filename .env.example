# --- Database (Supabase, Neon, Railway, etc.) ---
# Pooled connection (PgBouncer, transaction mode, usually port 6543) — used at runtime.
DATABASE_URL="postgresql://user:password@host:6543/bytehaven?pgbouncer=true"
# Direct connection (usually port 5432) — used by Prisma Migrate/introspection.
DIRECT_URL="postgresql://user:password@host:5432/bytehaven"

# --- NextAuth.js (Auth.js) admin session ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- First admin account (seeded once, no public sign-up) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Paystack ---
# Secret key is server-side only — never expose it to the client or commit a real value.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- WhatsApp Business click-to-chat ---
# International format, no "+" or leading zeros, e.g. 2348012345678
WHATSAPP_BUSINESS_NUMBER="234XXXXXXXXXX"

# --- Transactional email provider (Resend/SendGrid/Postmark) ---
EMAIL_PROVIDER_API_KEY="replace-with-your-email-provider-key"
EMAIL_FROM_ADDRESS="orders@bytehaven.example"

# --- Image storage (Supabase Storage / Cloudinary / S3) ---
IMAGE_STORAGE_PROVIDER="supabase"
IMAGE_STORAGE_URL="https://your-project.supabase.co"
IMAGE_STORAGE_BUCKET="product-images"
IMAGE_STORAGE_ACCESS_KEY="replace-with-your-storage-access-key"
IMAGE_STORAGE_SECRET_KEY="replace-with-your-storage-secret-key"
